# Puerto entero entre 1 y 65535 (3000 si se omite)
PORT=3000

# Obligatorio: secreto aleatorio de al menos 32 caracteres. No usar placeholders.
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Copiar el resultado aqui antes de iniciar. El servidor rechaza el valor vacio.
JWT_SECRET=

# Duracion entera positiva con unidad: ms, s, m, h, d, w, y; minimo 1 segundo.
# Ejemplos: 1h, 7d, 30m. No usar numeros sin unidad. 7d si se omite.
JWT_EXPIRES_IN=7d

# Obligatoria: URL postgres:// o postgresql:// con host y nombre de base.
# Estas credenciales son solo para el contenedor de desarrollo local.
DATABASE_URL=postgresql://auth_user:auth_pass_dev@localhost:5432/auth_api?schema=public

# Opcional. Por defecto usa <repo>/uploads/avatars. Debe ser una ruta absoluta si se configura.
AVATAR_STORAGE_DIR=
