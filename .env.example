# Puerto en el que correra el servidor
PORT=3000

# Secreto usado para firmar los JWT. Cambialo por una cadena larga y aleatoria.
JWT_SECRET=cambia_este_secreto_por_una_cadena_larga_y_aleatoria

# Tiempo de expiracion de los tokens (formato aceptado por jsonwebtoken, ej: 1h, 7d, 30m)
JWT_EXPIRES_IN=7d

# Conexion al contenedor local de PostgreSQL
DATABASE_URL=postgresql://auth_user:auth_pass_dev@localhost:5432/auth_api?schema=public
