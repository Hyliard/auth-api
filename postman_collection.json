    {
      "name": "Delete Account",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"NewPassword456!\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] }
      }
    },
    {
      "name": "Login tras eliminar cuenta (debe dar 401)",
      "request": {
