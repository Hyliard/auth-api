{
  "info": {
    "name": "Auth API Local",
    "description": "Coleccion para probar la API REST de autenticacion con PostgreSQL. Ejecuta las requests en orden: Health -> Register -> Login -> Me -> Devices -> Unlink Device -> Change Password -> Login (nueva password) -> Logout -> Delete Account.\n\nFase 1: inputs invalidos -> 400; email duplicado -> 409; limites por 15 min: registro 10/IP, login 30/IP, cambio de password y borrado 10 combinadas/usuario -> 429 con Retry-After. Password: 8 caracteres minimo y 72 bytes UTF-8 maximo. JWT y endpoints mantienen sus respuestas exitosas. Se requiere configurar un JWT_SECRET propio antes de iniciar el servidor.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "deviceId", "value": "", "type": "string" },
    { "key": "otherDeviceId", "value": "", "type": "string" },
    { "key": "otherToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Luis Martinez\",\n  \"email\": \"luis@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login exitoso', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('token', jsonData.token);",
              "}",
              "if (jsonData.deviceId) {",
              "    pm.collectionVariables.set('deviceId', jsonData.deviceId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"luis@example.com\",\n  \"password\": \"Password123!\",\n  \"deviceName\": \"Postman MacBook\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "Login - Segundo dispositivo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('otherToken', jsonData.token);",
              "}",
              "if (jsonData.deviceId) {",
              "    pm.collectionVariables.set('otherDeviceId', jsonData.deviceId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"luis@example.com\",\n  \"password\": \"Password123!\",\n  \"deviceName\": \"Postman iPhone\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
      }
    },
    {
      "name": "List Devices",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/api/devices", "host": ["{{baseUrl}}"], "path": ["api", "devices"] }
      }
    },
    {
      "name": "Unlink Other Device",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/devices/{{otherDeviceId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "devices", "{{otherDeviceId}}"]
        }
      }
    },
    {
      "name": "Me con token de dispositivo desvinculado (debe dar 401)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{otherToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
      }
    },
    {
      "name": "Change Password",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"Password123!\",\n  \"newPassword\": \"NewPassword456!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/change-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "change-password"]
        }
      }
    },
    {
      "name": "Me con token viejo tras cambiar password (debe dar 401)",
