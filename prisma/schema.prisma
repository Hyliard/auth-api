generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  email          String     @unique
  passwordHash   String
  avatarFilename String?
  createdAt      DateTime   @default(now())
  devices        Device[]
  sessions       Session[]
  clients        Client[]
  contracts      Contract[]
  workLogs       WorkLog[]
  invoices       Invoice[]
  payments       Payment[]
}

model Device {
  deviceId    String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  deviceName  String
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime
  active      Boolean   @default(true)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    Session[]

  @@index([userId])
}

model Session {
  sessionId String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  deviceId  String   @db.Uuid
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
}

model Client {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  name      String
  email     String?
  company   String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts Contract[]
  invoices  Invoice[]
  payments  Payment[]

  @@index([userId])
}

model Contract {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  clientId     String    @db.Uuid
  name         String
  hourlyRate   Decimal
  currency     String
  overtimeRate Decimal?
  active       Boolean   @default(true)
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  workLogs     WorkLog[]
  invoices     Invoice[]

  @@index([userId])
  @@index([clientId])
  @@index([userId, clientId])
}

model WorkLog {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  contractId  String          @db.Uuid
  workDate    DateTime        @db.Date
  hours       Decimal
  isOvertime  Boolean         @default(false)
  note        String?
  active      Boolean         @default(true)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contract    Contract        @relation(fields: [contractId], references: [id], onDelete: Restrict)
  invoiceLink InvoiceWorkLog?

  @@index([userId])
  @@index([contractId])
  @@index([userId, contractId])
  @@index([userId, workDate])
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  CANCELLED
}

model Invoice {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  clientId   String           @db.Uuid
  contractId String?          @db.Uuid
  number     String?
  periodFrom DateTime?        @db.Date
  periodTo   DateTime?        @db.Date
  currency   String
  subtotal   Decimal
  status     InvoiceStatus    @default(PENDING)
  issuedAt   DateTime?        @db.Date
  dueDate    DateTime?        @db.Date
  note       String?
  active     Boolean          @default(true)
  deletedAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  client     Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contract   Contract?        @relation(fields: [contractId], references: [id], onDelete: Restrict)
  workLogs   InvoiceWorkLog[]
  payments   Payment[]

  @@index([userId])
  @@index([clientId])
  @@index([contractId])
  @@index([userId, clientId])
  @@index([userId, status])
  @@index([userId, dueDate])
}

model InvoiceWorkLog {
  invoiceId String   @db.Uuid
  workLogId String   @unique @db.Uuid
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  workLog   WorkLog  @relation(fields: [workLogId], references: [id], onDelete: Restrict)

  @@id([invoiceId, workLogId])
  @@index([invoiceId])
  @@index([workLogId])
}

model Payment {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  invoiceId String    @db.Uuid
  clientId  String    @db.Uuid
  amount    Decimal
  currency  String
  paidAt    DateTime  @db.Date
  method    String?
  note      String?
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([invoiceId])
  @@index([clientId])
  @@index([userId, paidAt])
}
